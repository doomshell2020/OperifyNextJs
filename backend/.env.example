# Application settings. Use the deployed origins for staging/production.
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
# Optional additional frontend origins, comma-separated.
CORS_ORIGINS=

# Backend-only database and authentication configuration.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=operify
JWT_SECRET=replace-with-a-private-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-private-random-secret
