# Application settings. Use the deployed origins for staging/production.
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
# Optional additional frontend origins, comma-separated.
CORS_ORIGINS=
# Optional absolute private file-storage directory; defaults to backend/storage/designsheet.
DESIGNSHEET_UPLOAD_DIR=

# Backend-only database and authentication configuration.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=operify
JWT_SECRET=replace-with-a-private-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-private-random-secret

# Optional Maintenance Manager notification delivery (backend only).
MAINTENANCE_WHATSAPP_URL=
MAINTENANCE_WHATSAPP_KEY=
# Path to the existing Firebase service-account JSON; GOOGLE_APPLICATION_CREDENTIALS also works.
MAINTENANCE_FIREBASE_CREDENTIALS=
# Alternatively supply the service-account values directly.
MAINTENANCE_FIREBASE_PROJECT_ID=
MAINTENANCE_FIREBASE_CLIENT_EMAIL=
MAINTENANCE_FIREBASE_PRIVATE_KEY=
